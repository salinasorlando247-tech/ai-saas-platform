{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForgeAI Video Spec",
  "type": "object",
  "required": [
    "forge_version",
    "industry",
    "platform_targets",
    "duration_seconds",
    "hook_type",
    "timeline"
  ],
  "properties": {
    "forge_version": {
      "type": "string",
      "example": "1.0"
    },
    "industry": {
      "type": "string",
      "example": "fitness"
    },
    "platform_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tiktok",
          "instagram",
          "youtube",
          "shorts",
          "facebook",
          "x",
          "linkedin",
          "snapchat",
          "pinterest",
          "reddit",
          "threads",
          "tumblr",
          "whatsapp",
          "telegram",
          "discord",
          "vimeo",
          "rumble",
          "kick",
          "twitch",
          "spotify_video"
        ]
      }
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 5,
      "maximum": 300
    },
    "hook_type": {
      "type": "string",
      "enum": ["curiosity", "authority", "shock", "emotional"]
    },
    "captions": {
      "type": "object",
      "properties": {
        "style": { "type": "string" },
        "position": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "action"],
        "properties": {
          "start": { "type": "number" },
          "end": { "type": "number" },
          "action": { "type": "string" }
        }
      }
    }
  }
}
